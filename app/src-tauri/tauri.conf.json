{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Winsle",
  "version": "1.0.0",
  "identifier": "com.winsle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    },
    "windows": [
      {
        "label": "island",
        "title": "Winsle",
        "url": "index.html",
        "width": 240,
        "height": 6,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "center": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,Translate,OptimizationHints,MediaRouter,AutofillServerCommunication,BackForwardCache,AudioServiceOutOfProcess,SpareRendererForSitePerProcess,Prerender2 --enable-features=NetworkServiceInProcess2 --autoplay-policy=no-user-gesture-required --renderer-process-limit=1 --disable-background-networking --disable-component-update --disable-extensions --js-flags=--max-old-space-size=128 --disable-gpu --in-process-gpu"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/winsle-hook.exe": "winsle-hook.exe"
    },
    "copyright": "© Winsle contributors. MIT licensed.",
    "category": "DeveloperTool",
    "shortDescription": "Mochi lives at the top of your screen",
    "longDescription": "Winsle puts Mochi at the top of your screen: it shows your Claude Code sessions and a few integrations, and lets you approve, answer, chat and drop files without leaving what you are doing.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "French"
        ],
        "installerHooks": "nsis/hooks.nsh",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyOTAxNjIyMUEwMEQ5OUYKUldTZjJRQWFJaGFROGhSeWIxZUQ1L3ZWZ3JlYTVKYSs4NG1abWNJcVFPc3B0ODJ5WFZndFQyUWsK",
      "endpoints": [
        "https://github.com/IntellectDaksh/Winsle/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
