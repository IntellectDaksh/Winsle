# Winsle optional config. Copy to `.env` (next to winsle.exe, or the app folder in dev).
# Anything set in Settings (stored in Windows Credential Manager) overrides these.
# Never commit `.env` — it is gitignored.

# Calendar: Google Calendar > Settings > "Secret address in iCal format"
WINSLE_CALENDAR_ICS_URL=

# AI chat
WINSLE_ANTHROPIC_API_KEY=

# Integrations (all optional)
WINSLE_GITHUB_TOKEN=
WINSLE_VERCEL_TOKEN=
WINSLE_STRIPE_API_KEY=
WINSLE_RESEND_API_KEY=
WINSLE_NOTION_API_KEY=
WINSLE_CALCOM_API_KEY=
WINSLE_N8N_URL=
WINSLE_N8N_API_KEY=

# Spotify needs no key: now-playing comes from Windows media controls (SMTC),
# lyrics from lrclib.net (public, keyless).
# Optional Spotify account link (like, queue, playlists). Release builds embed the app client ID.
WINSLE_SPOTIFY_CLIENT_ID=
# Calendar sign-in (Google / Outlook). Release builds embed these; see docs/OAUTH-SETUP.md.
WINSLE_GOOGLE_CLIENT_ID=
WINSLE_GOOGLE_CLIENT_SECRET=
WINSLE_MICROSOFT_CLIENT_ID=
