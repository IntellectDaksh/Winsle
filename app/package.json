{
  "name": "winsle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/gen-icons.mjs",
    "test:calc": "node scripts/test-calc.mjs",
    "test:lyrics": "node scripts/test-lyrics.mjs",
    "test:security": "node scripts/test-security.mjs",
    "test:hooks": "node scripts/test-hooks.mjs",
    "test:formatters": "node scripts/test-formatters.mjs",
    "test": "node scripts/test-calc.mjs && node scripts/test-lyrics.mjs && node scripts/test-security.mjs && node scripts/test-hooks.mjs && node scripts/test-formatters.mjs",
    "tauri": "tauri",
    "predev": "cargo build --release -p winsle-hook",
    "prebuild": "cargo build --release -p winsle-hook",
    "pack": "tauri build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^6"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
